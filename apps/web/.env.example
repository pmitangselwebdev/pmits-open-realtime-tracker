# ──────────────────────────────────────────────
# Required — Database (PostgreSQL + PostGIS)
# ──────────────────────────────────────────────
# Vercel Postgres (native):
#   Dashboard → Storage → Create Database → Connect → Copy .env
# DATABASE_URL="postgresql://user:pass@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Local dev (Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"

# ──────────────────────────────────────────────
# Required — KV (Redis for rate limiting + cache)
# ──────────────────────────────────────────────
# Vercel KV (native):
#   Dashboard → Storage → Create KV → Connect → Copy .env
# KV_URL="redis://default:password@us1-special-12345.upstash.io:6379"
#
# Local dev (Docker):
# REDIS_URL="redis://localhost:6379"
KV_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# Required — NextAuth
# ──────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# ──────────────────────────────────────────────
# Optional — Supabase Realtime (free-tier broadcast)
# ──────────────────────────────────────────────
# Falls back to 10s polling when not set.
# Create free project at https://supabase.com
# Get from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ──────────────────────────────────────────────
# Optional — Sentry (error tracking)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ──────────────────────────────────────────────
# Optional — CORS
# ──────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ──────────────────────────────────────────────
# Optional — Public URL
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
