# ──────────────────────────────────────────────
# Database (PostgreSQL + PostGIS)
# ──────────────────────────────────────────────
# Local: use Docker PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"
#
# Production (serverless, recommended free tiers):
#   Neon:  https://neon.tech  (serverless Postgres, 0.5GB free)
#   Supabase: https://supabase.com (500MB free)
#
# Neon connection string example:
# DATABASE_URL="postgresql://user:pass@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"

# ──────────────────────────────────────────────
# Redis (caching, rate limiting, pub/sub)
# ──────────────────────────────────────────────
# Local: uncomment for Docker Redis
# REDIS_URL="redis://localhost:6379"
#
# Production (serverless, recommended):
#   Upstash: https://upstash.com  (256MB free, REST API)
# REDIS_URL="rediss://default:password@us1-special-12345.upstash.io:6379"
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# ──────────────────────────────────────────────
# Supabase (optional — for real-time broadcast)
# ──────────────────────────────────────────────
# Create free project at https://supabase.com
# Get these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ──────────────────────────────────────────────
# Sentry (optional — error tracking)
# ──────────────────────────────────────────────
# Create account at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ──────────────────────────────────────────────
# CORS (optional — comma-separated allowed origins)
# ──────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ──────────────────────────────────────────────
# Production
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
