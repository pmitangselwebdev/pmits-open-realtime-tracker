generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      String     @default("user")
  createdAt DateTime   @default(now())
  vehicles  Vehicle[]
  geofences Geofence[]
  events    Event[]
  schedules Maintenance[]
}

model Vehicle {
  id            String        @id @default(cuid())
  name          String
  plate         String
  uniqueId      String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  icon          String?
  color     String?    @default("#dc2626")
  createdAt     DateTime      @default(now())
  locations     Location[]
  events        Event[]
  trips         Trip[]
  stops         Stop[]
  schedules     Maintenance[]
  speedLimit    Float?

  @@index([userId])
  @@index([uniqueId])
}

model Location {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  battery   Float?
  timestamp DateTime @default(now())

  @@index([vehicleId, timestamp])
  @@index([timestamp])
}

model Geofence {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("circle")
  radius    Float?
  vertices  Json
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())
  events    Event[]

  @@index([userId])
}

model Event {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  geofenceId String?
  geofence   Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)
  type       String
  message    String
  attributes Json?
  timestamp  DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([vehicleId, timestamp])
}

model Trip {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  startLat  Float
  startLng  Float
  endLat    Float
  endLng    Float
  distance  Float
  avgSpeed  Float?
  maxSpeed  Float?
  duration  Int

  @@index([vehicleId, startTime])
}

model Stop {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  lat       Float
  lng       Float
  duration  Int
  address   String?

  @@index([vehicleId, startTime])
}

model Maintenance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      String   @default("general")
  label     String
  periodKm  Float?
  periodDays Int?
  lastKm    Float?
  lastDate  DateTime?
  createdAt DateTime @default(now())

  @@index([vehicleId])
}
